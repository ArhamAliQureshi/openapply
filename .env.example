# Copy to .env.local and fill in. Never commit .env.local.

# Default AI provider until you choose models on the Settings page:
# "openrouter" (free models available), "ollama" (local, free, slower) or "claude".
AI_PROVIDER=openrouter

# OpenRouter: https://openrouter.ai/keys (free models need no credits; 50 requests/day,
# or 1,000/day after a one-time $10 credit purchase)
OPENROUTER_API_KEY=
# Optional override of the default OpenRouter model
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Claude (Anthropic API): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Local models through Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
# How long to wait for the local model (ms). Default 600000 = 10 minutes.
# OLLAMA_TIMEOUT_MS=600000

# Real application submission. Keep false until you've checked dry runs.
ALLOW_LIVE_SUBMIT=false

# Optional: use a real Postgres (with pgvector). Unset = embedded PGlite in ./.data
# DATABASE_URL=postgres://user:pass@localhost:5432/applykit

# Port the app runs on (the hourly autopilot scheduler calls itself on this port)
# PORT=3000
